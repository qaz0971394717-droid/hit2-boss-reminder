{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hit2-boss-reminder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",

  "durable_objects": {
    "bindings": [
      {
        "name": "BOSS_REMINDER",
        "class_name": "BossReminder"
      }
    ]
  },

  "exports": {
    "BossReminder": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
